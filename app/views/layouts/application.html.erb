<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Peanut Butter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Peanut Butter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      ul.nav_container {
        list-style-type: none;   
        width: fit-content;
        margin: 5px;
        padding: 0;
        display: flex;
        align-items: stretch;
        background-color: moccasin;
        outline-style: solid;
        outline-width: thick;
        outline-color: black;
      }

      body {
        background-color: tomato;
      }
      .info_block {
        background-color: moccasin;
        margin: 25px;
        padding: 20px;
        outline-style: double;
        outline-width: thick;
        outline-color: black;
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width:250px;
      }
      div.status {
        background-color: white;
        position: static;
        bottom: 10px;
        margin: 5px;
        outline-style: double;
        outline-color: black;
        text-align: center;
      }
      .yellow_headline{
        border-style: double; 
        border-width: thick;
        background-color: gold; 
        margin: 10px;
        padding: 10px;
        display: inline-block;
        text-align: center;
      }
      .button{
        border-color: black;
        border-style: double; 
        border-width: thick;
        background-color: gold; 
        margin: 10px;
        padding: 16px;
        display: inline-block;
        text-align: center;
        font-weight: bold;
        font-size: 16px;
        cursor: pointer;      
        white-space: nowrap;
        }
      .button:hover {
        background-color: yellow; 
      }
      .nav_container .button{
        margin: 10px;
        padding: 25px;   
        font-size: 20px;     
      }
      .yellow_headline a:link, .yellow_headline a:visited{
        color: black;
        padding: 6px;
        text-align: center;
        text-decoration: none;
        display: inline;        
        white-space: nowrap;
        vertical-align: middle;
      }
      .yellow_headline a:hover {
        background-color: yellow; 
      }

    </style>
    <nav>        
      <ul class="nav_container">
          <li><h2><%= button_to "Gamejams", root_path, method: :get, class: "button" %></h2></li>
          <% if authenticated? %>
            <li><h2><%= button_to "My Gamejams", new_session_path, method: :get, class: "button", disabled: true %></h2></li>
            <li><h2><%= button_to "Joined Jams", new_session_path, method: :get, class: "button", disabled: true %></h2></li>
            <li><h2><%= button_to "My Submissions", new_session_path, method: :get, class: "button", disabled: true %></h2></li>
            <li><h2><%= button_to "Profile", user_path(Current.user.id), method: :get, class: "button", disabled: true%></h2></li>
            <li><h2><%= button_to "Log out", session_path, method: :delete, class: "button" %></h2></li>
          <% else %>
            <li><h2><%= button_to "Log in", new_session_path, method: :get, class: "button" %></h2></li>
            <li><h2><%= button_to "Sign up", sign_up_path, method: :get, class: "button" %></h2></li>
          <% end %>
      </ul>
    </nav>

  </head>

   <body>
    <main>
      <%= yield %>
    </main>
   </body>

</html>
