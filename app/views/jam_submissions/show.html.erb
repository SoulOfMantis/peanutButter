<style>
.container {
  display: flex;
  align-items: center;
}
</style>

<ul type="none" class="container">
  <li><h1><%= @jam_submission.name %></h1></li> 
  <li class="linking_headline"><h3><%= link_to "Back to other submissions", gamejam_jam_submissions_path(@jam_submission.gamejam) %></h3></li>
</ul>

<ul class="container" type="none">
  <li class="jam_block"> 
    <div>Author: <%= link_to @jam_submission.author.nickname, user_path(@jam_submission.author.id) %></div>
    <div><%=@jam_submission.description.nil? ? "---" : @jam_submission.description%></div>
    <div class="status">Status: <%= @jam_submission.status %></div>
    <div><%= button_to "Edit", edit_gamejam_jam_submission_path(@jam_submission), method: :get if @jam_submission.authored_by_current_user? %></div>
    <div><%= button_to "Delete", [@jam_submission.gamejam, @jam_submission], method: :delete, data: { turbo_confirm: "Are you sure?" } if @jam_submission.authored_by_current_user? %></div>
  </li>
</ul>


