<style>
.container {
  display: flex;
  align-items: stretch;
}
</style>
  <h1 class="yellow_headline"><%= link_to @jam_submission.name, gamejam_jam_submission_path(@jam_submission.gamejam, @jam_submission) %></h1></li> 
  <h1 class="yellow_headline"><%= link_to "Back to other submissions", gamejam_jam_submissions_path(@jam_submission.gamejam) %></h1>
<br>
<div class="info_block"> 
    <div>Author: <%= link_to @jam_submission.author.nickname, user_path(@jam_submission.author.id) %></div>
    <div><%=@jam_submission.description.nil? ? "---" : @jam_submission.description%></div>
    <div class="status">Status: <%= @jam_submission.status %></div>
    <% if @jam_submission.authored_by_current_user? %>  
      <div class="yellow_headline"><%= link_to "Edit", edit_gamejam_jam_submission_path(@jam_submission), method: :patch %></div>
      <div class="yellow_headline"><%= link_to "Delete", [@jam_submission.gamejam, @jam_submission], data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></div>
    <% end %>
    
  </div>


