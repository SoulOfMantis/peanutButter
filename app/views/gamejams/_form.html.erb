<div class="info_block">
<%= form_with model: gamejam do |form| %>

  <div>
    <%= form.text_field :name, required: true, placeholder: "Name" %>
  </div>

  <div>
    <%= form.text_field :theme, required: true, placeholder: "Theme" %>
  </div>

  <div>
    <%= form.text_area :description, placeholder: "Description" %>
  </div>

  <div>
    <%= form.label :starts_in %>
    <%= form.number_field :starts_in, in: 7..31, :value => 7 %> days from now
  </div>

  <div>
    <%= form.label :lasts_for %>
    <%= form.number_field :lasts_for, in: 1..14, :value => 2 %> days
  </div>
  
  <div>
    <% if can_be_published %>
      <%= form.select :status, [["Save as draft", "Draft"], ["Publish","Published"], ["Start", "Ongoing"]], selected: gamejam.status %>
    <% end %>
  </div>

  <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
  <% end %>

  <div>
    <%= form.submit "Submit", class: "button" %>
  </div>

<% end %>
</div>
