<style>
.container {
  display: flex;
  align-items: center;
}
</style>

<ul type="none" class="container">
<h1 style="float: left"><%= @gamejam.name %></h1>
  <% if @gamejam.was_started? %>  
    <li class="linking_headline"><h3><%= link_to "Submissions", gamejam_jam_submissions_path(@gamejam), gamejam: @gamejam %></h3></li>
  <% end %>
  <li class="linking_headline"><h3><%= link_to "Back to other gamejams", gamejams_path %></h3></li>
</ul>
<ul class="container" type="none">
  <li class="jam_block"> 
    <div>Author: <%= link_to @gamejam.author.nickname, user_path(@gamejam.author.id) %></div>
    <div><%=@gamejam.description.nil? ? "---" : @gamejam.description%></div>
    <div>Theme: <%= (@gamejam.was_started? or @gamejam.authored_by_current_user?) ? @gamejam.theme : "Hidden"%></div>
    <div>Starts: <%= @gamejam.start_date %></div>
    <div>Ends: <%= @gamejam.end_date %></div>
    <div class="status">Status: <%= @gamejam.status %></div>
    <div><%= button_to "Edit", edit_gamejam_path(@gamejam), method: :get if @gamejam.authored_by_current_user?%></div>
    <div><%= button_to "Delete", @gamejam, method: :delete, data: { turbo_confirm: "Are you sure?" } if @gamejam.authored_by_current_user? %></div>
  </li>
</ul>
<% link_to "Join", gamejams_path if authenticated? and !@gamejam.was_started? %>


