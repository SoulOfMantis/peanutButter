<style>
.container {
  display: flex;
  align-items: stretch;
}
</style>

<h1 class="yellow_headline"><%= link_to @gamejam.name, gamejam_path(@gamejam), gamejam_id: @gamejam.id %></h1>
  <% if @gamejam.accessible? %>  
    <h1 class="yellow_headline"><%= link_to "Commands", gamejam_commands_path(@gamejam), gamejam: @gamejam %></h1>
    <% if @gamejam.theme_available? %>  
      <h1 class="yellow_headline"><%= link_to "Submissions", gamejam_submissions_path(@gamejam), gamejam: @gamejam %></h1>
    <% end %>
  <% end %>
  <h1 class="yellow_headline"><%= link_to "To other gamejams", gamejams_path %></h1>
<br>
<div class="info_block"> 
    <div>Author: <%= link_to @gamejam.author.nickname, user_path(@gamejam.author) %></div>
    <div>Description: <%=@gamejam.description.empty? ? "---" : @gamejam.description%></div>
    <div>Theme: <%= (@gamejam.theme_available?) ? @gamejam.theme : "Hidden"%></div>
    <div>Starts: <%= @gamejam.start_date %></div>
    <div>Ends: <%= @gamejam.end_date %></div>
    <div class="status">Status: <%= @gamejam.status %></div>
    <% if @gamejam.authored_by_current_user? and !@gamejam.was_started? %>  
      <div class="yellow_headline"><%= link_to "Edit", edit_gamejam_path(@gamejam), method: :get%></div>
      <div class="yellow_headline"><%= link_to "Delete", @gamejam, data: { turbo_confirm: "Are you sure?", turbo_method: :delete } %></div>
    <% end %>
</div>

