<%= link_to "Login or sign up", new_session_path unless authenticated? %>
<h1>Gamejams</h1>


<div id="gamejams">
  <ul type="none" style="columns: 100px 3">
  <% @gamejams.select{|gj| gj.accessible?}.each do |gamejam| %>
    <li style="break-inside: avoid"> 
      <%= link_to gamejam.name, gamejam_path(gamejam.id) %>
      <div>Author: <%= link_to gamejam.author.nickname, user_path(gamejam.author.id) %></div>
      <div><%=gamejam.description.nil? ? "---" : gamejam.description%></div>
      <div>Status: <%= gamejam.status %></div>
    </li>
    <br>
  <% end %>
    <li style="break-inside: avoid"> 
      <%= link_to "Create new Gamejam", new_gamejam_path if authenticated? %>
    </li>
  </ul>
</div>
