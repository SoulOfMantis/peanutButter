<h1>New gamejam</h1>

<%= form_with model: @gamejam do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :theme %>
    <%= form.text_field :theme %>
  </div>
  <div>
    <%= form.label :description %>
    <%= form.text_field :description %>
  </div>
  <div>
    <%= form.label :start_date %>
    <%= form.date_select :start_date, start_month: Time.now.month, start_year: Time.now.year, end_year: Time.now.year+2, start_date: 3.days.from_now, default: 3.days.from_now %>
  </div>
  <div>
    <%= form.label :end_date %>
    <%= form.date_select :end_date, start_month: Time.now.month, start_year: Time.now.year, end_year: Time.now.year+2, start_date: 4.days.from_now, default: 4.days.from_now %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<%= link_to "Cancel", gamejams_path %>

