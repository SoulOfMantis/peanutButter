<h1 class="yellow_headline"><%= link_to @user.nickname, [@user] %></h1>
<h1 class="yellow_headline"><%= link_to "Created gamejams", "/profile/#{@user.nickname}/authored_gamejams", method: :get %></h1>
<h1 class="yellow_headline"><%= link_to "Jam commands", "/profile/#{@user.nickname}/jam_commands" %></h1>
<h1 class="yellow_headline"><%= link_to "Jam submissions", "/profile/#{@user.nickname}/jam_submissions" %></h1>
<br>
<div class="info_block"> 
  <div>Joined: <%= @user.created_at.to_date.to_fs(:long_ordinal) %></div>
  <div><%="Description: " + @user.description unless @user.description.nil? or @user.description.empty? %></div>
  <% if @user.is_current? %>  
    <div class="yellow_headline"><%= link_to "Edit", edit_user_path(@user), method: :get%></div>
    <div class="yellow_headline"><%= link_to "Delete", @user, data: { turbo_confirm: "Are you sure?", turbo_method: :delete } %></div>
  <% end %>
</div>

