<style>
.container {
  display: flex;
  align-items: center;
}
</style>

<h1 class="yellow_headline">Sign Up</h1>

<br>
<div class="info_block" style="text-align: center; display: inline-block; width: 200px">
<%= form_with model: @user, url: sign_up_path do |form| %>
  <div>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "given-name", maxlength: 20, placeholder: "Enter your name" %>
  </div>

  <div>
    <%= form.text_field :nickname, required: true, autocomplete: "nickname", maxlength: 20, placeholder: "Enter your nickname" %>
  </div>

  <div>
    <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "Enter your email address" %>
  </div>

  <div>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 20, placeholder: "Enter your password" %>
  </div>

  <div>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 20, placeholder: "Confirm your password" %>
  </div>

  <% if form.object.errors.any? %>
    <div><%= form.object.errors.full_messages.first %></div>
  <% end %>

  <div>
    <%= form.submit "Sign up", class: "button" %>
  </div>
<% end %>
</div>
