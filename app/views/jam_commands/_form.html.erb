<br>
<div class="info_block">
<%= form_with model: jam_command, url: gamejam_commands_path(params[:gamejam_id]) do |form| %>
    <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
    <% end %>

  <div>
    <%= form.text_field :name, required: true, placeholder: "Enter name" %>
  </div>

  <br>
  <div>
    <%= form.text_area :description, placeholder: "Enter description" %>
  </div>

  <div>
    <%= form.select :status, [["Make private", "Private"], ["Publish","Public"], ["Go solo", "Solo"]], selected: jam_command.status %>
  </div>

  <div>
    <%= form.submit "Submit", class: "button" %>
  </div>
<% end %>
</div>
