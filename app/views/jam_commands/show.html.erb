<style>
.container {
  display: flex;
  align-items: stretch;
}
</style>
  <h1 class="yellow_headline"><%= link_to @jam_command.name, gamejam_command_path(@jam_command.joined_jam, @jam_command) %></h1></li> 
  <h1 class="yellow_headline"><%= link_to "Back to other commands", gamejam_commands_path(@jam_command.joined_jam) %></h1>
<br>
<div class="info_block"> 
    <div>Authors:</div>
    <div><%=@jam_command.description.nil? ? "---" : @jam_command.description%></div>
    <div class="status">Status: <%= @jam_command.status %></div>
    <% if @jam_command.authored_by_current_user? %>  
      <div class="yellow_headline"><%= link_to "Edit", edit_gamejam_command_path(@jam_command), method: :patch %></div>
      <div class="yellow_headline"><%= link_to "Delete", gamejam_command_path(@jam_command.joined_jam, @jam_command), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></div>
    <% end %>
    
  </div>


